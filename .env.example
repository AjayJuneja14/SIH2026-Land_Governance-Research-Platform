# ==============================================
# KisanConnect Environment Variables
# ==============================================

# Backend Database (PostgreSQL)
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
DATABASE_URL="postgresql://postgres:password123@localhost:5432/kisanconnect?schema=public"

# Backend Server Port & Secret
PORT=5000
JWT_SECRET="kisanconnect_super_secret_jwt_key_2026"
JWT_EXPIRES_IN="7d"

# Frontend Next.js Public URL & Backend API URL
NEXT_PUBLIC_API_URL="http://localhost:5000/api"
NEXT_PUBLIC_APP_NAME="KisanConnect"
